{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "size-limit": [
    {
      "name": "JS total de TODOS los chunks, incluidos los diferidos (búsqueda ~40 KB, WebGL ~3 KB, checkout ~4 KB) — alarma de crecimiento; el JS inicial por ruta lo controla Lighthouse CI",
      "path": ".next/static/chunks/**/*.js",
      "limit": "280 KB",
      "gzip": true
    }
  ],
