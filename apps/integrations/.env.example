# Servicio de integraciones (VPS). Copiar a .env en el servidor: NUNCA subir el .env real.
PORT=8787
# Mismo valor que INTEGRATIONS_HMAC_SECRET en Vercel (>= 32 caracteres aleatorios).
INTEGRATIONS_HMAC_SECRET=

# --- Andreani (datos que entrega el ejecutivo comercial de Andreani) ---
# sandbox = apisqa.andreani.com · production = apis.andreani.com
ANDREANI_ENV=sandbox
ANDREANI_USER=
ANDREANI_PASSWORD=
# Código de cliente, ej. CL0001234
ANDREANI_CLIENT=
# Número de contrato del servicio "envío a domicilio"
ANDREANI_CONTRACT_HOME=
# Número de contrato del servicio "retiro en sucursal"
ANDREANI_CONTRACT_BRANCH=
# Sucursal de origen (si el contrato la pide)
ANDREANI_ORIGIN_BRANCH=
ANDREANI_TIMEOUT_MS=4000

# --- Credenciales desde el administrador (recomendado) ---
# Con estos tres datos el servicio toma lo cargado en /admin/integraciones (prioridad sobre lo de arriba).
SUPABASE_URL=https://tblitemxzgeolktuieph.supabase.co
SUPABASE_ANON_KEY=
# Mismo valor que CHECKOUT_SERVER_KEY de la web
APP_SERVER_KEY=
