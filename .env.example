# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Staging (São Paulo): https://tblitemxzgeolktuieph.supabase.co + clave publishable (Dashboard > API Keys)
# Local con Docker: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Catálogo: "supabase" lee la base; sin definir usa apps/web/lib/catalog/fixture.json
CATALOG_SOURCE=
SUPABASE_SERVICE_ROLE_KEY=            # solo servidor

# --- Pagos (ADR-002) ---
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
GETNET_ENV=sandbox
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_WEBHOOK_SECRET=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="Balance Beauty <pedidos@balancebeauty.com.ar>"
EMAIL_ADMIN_NOTIFICATIONS=

# --- Antispam / rate limit ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observabilidad / analytics ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Internos ---
CRON_SECRET=
REVALIDATE_SECRET=
# Firma de la cookie del carrito (>= 32 caracteres). Obligatoria en producción.
CART_SECRET=

# --- Servicio de integraciones (VPS Contabo) ---
INTEGRATIONS_URL=http://localhost:8787
INTEGRATIONS_HMAC_SECRET=
INTEGRATIONS_TIMEOUT_MS=2500

